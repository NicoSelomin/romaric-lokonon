{
  "name": "romaric-lokonon-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site portfolio de Romaric Lokonon, sculpteur sur bois (Bénin)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "python3 -m http.server 4173 --directory dist",
    "dev": "node build.mjs && python3 -m http.server 4173 --directory dist",
    "deploy:preview": "node build.mjs && npx --yes netlify-cli@27.20.1 deploy --dir=dist --site 69c04d2f-dc04-4428-8d4c-9599b66e3afd",
    "deploy": "node build.mjs && npx --yes netlify-cli@27.20.1 deploy --dir=dist --prod --site 69c04d2f-dc04-4428-8d4c-9599b66e3afd",
    "admin:local": "npx --yes decap-server@3"
  },
  "devDependencies": {
    "netlify-plugin-cache": "^1.0.3"
  }
}